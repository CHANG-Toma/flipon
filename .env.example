# Redis (duo lobby) — local Docker OU Upstash / Vercel Storage
# Local (voir docker-compose + .env.docker) :
# REDIS_URL="redis://:REDIS_PASSWORD@127.0.0.1:6379"
REDIS_URL=

# Postgres — Prisma
# Local Docker (recommandé pour tests avant o2switch) :
# DATABASE_URL="postgresql://flipon:PASSWORD@127.0.0.1:5432/flipon?schema=public&connection_limit=10"
# Prod o2switch :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DATABASE_URL=

# Clerk (serveur) — vérif JWT app mobile
CLERK_SECRET_KEY=

# RevenueCat — webhook billing (Authorization: Bearer …)
# Secret min. 16 caractères. Obligatoire pour accepter les webhooks.
# REVENUECAT_WEBHOOK_SECRET=rc_whsec_xxx_min_16_chars
# Dev only — force Premium API pour ces Clerk user IDs (hors production)
# DEV_PREMIUM_CLERK_IDS=user_xxx,user_yyy
# En production, activer explicitement si besoin de tester :
# ALLOW_DEV_PREMIUM=1

# Feedback → ton e-mail via Web3Forms (https://web3forms.com)
# IMPORTANT : le préfixe NEXT_PUBLIC_ est requis (envoi depuis le navigateur,
# pour éviter le blocage Cloudflare quand le serveur Vercel appelle Web3Forms).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Option alternative (serveur) : Resend
# RESEND_API_KEY=
# FEEDBACK_TO_EMAIL=ton@email.fr

# --- Premium IA (deck localisé) ---
# Gemini 2.5 Flash-Lite (recommandé). Clé : https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# Fallback optionnel Groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# User-Agent Nominatim / Overpass (lieux OSM)
# OSM_USER_AGENT=FlipOn/1.0 (dev; toi@email.fr)
# En dev, le deck IA/POI peut tourner sans abo si contexte envoyé (désactiver: ALLOW_DEV_AI_DECK=0)
# ALLOW_DEV_AI_DECK=1
