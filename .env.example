# Redis (duo lobby) — local Docker OU Upstash / Vercel Storage
# Local (voir docker-compose + .env.docker) :
# REDIS_URL="redis://:REDIS_PASSWORD@127.0.0.1:6379"
REDIS_URL=

# Postgres — Prisma
# Local Docker (recommandé pour tests avant o2switch) :
# DATABASE_URL="postgresql://flipon:PASSWORD@127.0.0.1:5432/flipon?schema=public&connection_limit=10"
# Prod o2switch :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DATABASE_URL=

# Clerk (serveur) — vérif JWT app mobile
CLERK_SECRET_KEY=

# Feedback → ton e-mail via Web3Forms (https://web3forms.com)
# IMPORTANT : le préfixe NEXT_PUBLIC_ est requis (envoi depuis le navigateur,
# pour éviter le blocage Cloudflare quand le serveur Vercel appelle Web3Forms).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Option alternative (serveur) : Resend
# RESEND_API_KEY=
# FEEDBACK_TO_EMAIL=ton@email.fr
