{
  "name": "flipon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:up": "docker compose --env-file .env.docker up -d",
    "db:down": "docker compose --env-file .env.docker down",
    "db:reset": "docker compose --env-file .env.docker down -v && docker compose --env-file .env.docker up -d",
    "db:logs": "docker compose --env-file .env.docker logs -f --tail=100",
    "db:ps": "docker compose --env-file .env.docker ps",
    "test:rc-webhook": "node --env-file=.env scripts/test-revenuecat-webhook.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.1",
    "@clerk/nextjs": "^7.7.4",
    "@prisma/client": "6.19.0",
    "gsap": "^3.15.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "ogl": "^1.0.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
